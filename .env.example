SECRET_KEY=change-me-to-a-random-value
DATABASE_URL=sqlite:///app.db

# Fernet key for encrypting stored provider credentials / SSH keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Let's Encrypt registration email used by certbot on deployed VPSes
LE_EMAIL=admin@example.com

# Google Search Console: path to the service-account JSON key, and (optional) your own
# Google account e-mail, added as owner of each verified domain so it shows in the GSC UI.
GOOGLE_SERVICE_ACCOUNT_FILE=
GSC_OWNER_EMAIL=

# Safe Browsing API key, used to flag domains on Google's malware/phishing lists.
SAFE_BROWSING_API_KEY=
